{
  "type": "minecraft:tree",
  "below_trunk_provider": {
    "type": "minecraft:rule_based",
    "fallback": {
      "id": "minecraft:dirt"
    },
    "rules": [
      {
        "if_true": {
          "type": "minecraft:matching_block_tag",
          "tag": "regions_unexplored:peat/substrate"
        },
        "then": {
          "type": "regions_unexplored:key_hack",
          "block": "regions_unexplored:peat_dirt"
        }
      },
      {
        "if_true": {
          "type": "minecraft:matching_block_tag",
          "tag": "regions_unexplored:silt/substrate"
        },
        "then": {
          "type": "regions_unexplored:key_hack",
          "block": "regions_unexplored:silt_dirt"
        }
      }
    ]
  },
  "decorators": [
    {
      "type": "regions_unexplored:hanging_vines",
      "block": "regions_unexplored:sky_wisteria_vines",
      "probability": 0.3
    },
    {
      "type": "minecraft:beehive",
      "probability": 0.002
    }
  ],
  "foliage_placer": {
    "type": "regions_unexplored:magnolia"
  },
  "foliage_provider": {
    "id": "regions_unexplored:sky_wisteria_leaves",
    "properties": {
      "distance": "7",
      "persistent": "false",
      "waterlogged": "false"
    }
  },
  "ignore_vines": true,
  "minimum_size": {
    "type": "minecraft:two_layers_feature_size"
  },
  "root_placer": {
    "type": "regions_unexplored:magnolia",
    "root_provider": {
      "id": "regions_unexplored:wisteria_log",
      "properties": {
        "axis": "y"
      }
    },
    "trunk_offset_y": 0
  },
  "trunk_placer": {
    "type": "regions_unexplored:magnolia",
    "height": {
      "type": "minecraft:uniform",
      "max_inclusive": 5,
      "min_inclusive": 2
    },
    "primary_branch_length": {
      "type": "minecraft:uniform",
      "max_inclusive": 5,
      "min_inclusive": 4
    },
    "secondary_branch_length": {
      "type": "minecraft:uniform",
      "max_inclusive": 3,
      "min_inclusive": 2
    }
  },
  "trunk_provider": {
    "id": "regions_unexplored:wisteria_log",
    "properties": {
      "axis": "y"
    }
  }
}