{
  "type": "minecraft:tree",
  "below_trunk_provider": {
    "type": "minecraft:rule_based",
    "fallback": {
      "id": "minecraft:dirt"
    },
    "rules": [
      {
        "if_true": {
          "type": "minecraft:matching_block_tag",
          "tag": "regions_unexplored:peat/substrate"
        },
        "then": {
          "type": "regions_unexplored:key_hack",
          "block": "regions_unexplored:peat_dirt"
        }
      },
      {
        "if_true": {
          "type": "minecraft:matching_block_tag",
          "tag": "regions_unexplored:silt/substrate"
        },
        "then": {
          "type": "regions_unexplored:key_hack",
          "block": "regions_unexplored:silt_dirt"
        }
      }
    ]
  },
  "decorators": [],
  "foliage_placer": {
    "type": "regions_unexplored:willow",
    "hanging_leaves_chance": 0.25
  },
  "foliage_provider": {
    "id": "regions_unexplored:willow_leaves",
    "properties": {
      "distance": "7",
      "persistent": "false",
      "waterlogged": "false"
    }
  },
  "ignore_vines": true,
  "minimum_size": {
    "type": "minecraft:two_layers_feature_size",
    "limit": 0,
    "min_clipped_height": 4,
    "upper_size": 0
  },
  "root_placer": {
    "type": "regions_unexplored:willow",
    "chance": 0.5,
    "height": {
      "type": "minecraft:uniform",
      "max_inclusive": 3,
      "min_inclusive": 2
    },
    "root_provider": {
      "id": "regions_unexplored:willow_log",
      "properties": {
        "axis": "y"
      }
    }
  },
  "trunk_placer": {
    "type": "minecraft:fancy_trunk_placer",
    "base_height": 9,
    "height_rand_a": 9,
    "height_rand_b": 0
  },
  "trunk_provider": {
    "id": "regions_unexplored:willow_log",
    "properties": {
      "axis": "y"
    }
  }
}