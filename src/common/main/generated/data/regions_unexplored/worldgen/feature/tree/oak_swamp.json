{
  "type": "minecraft:tree",
  "below_trunk_provider": {
    "type": "minecraft:rule_based",
    "fallback": {
      "id": "minecraft:dirt"
    },
    "rules": [
      {
        "if_true": {
          "type": "minecraft:matching_block_tag",
          "tag": "regions_unexplored:peat/substrate"
        },
        "then": {
          "type": "regions_unexplored:key_hack",
          "block": "regions_unexplored:peat_dirt"
        }
      },
      {
        "if_true": {
          "type": "minecraft:matching_block_tag",
          "tag": "regions_unexplored:silt/substrate"
        },
        "then": {
          "type": "regions_unexplored:key_hack",
          "block": "regions_unexplored:silt_dirt"
        }
      }
    ]
  },
  "decorators": [
    {
      "type": "minecraft:leave_vine",
      "probability": 0.25
    }
  ],
  "foliage_placer": {
    "type": "minecraft:blob_foliage_placer",
    "height": 3,
    "offset": 0,
    "radius": 3
  },
  "foliage_provider": {
    "id": "minecraft:oak_leaves",
    "properties": {
      "distance": "7",
      "persistent": "false",
      "waterlogged": "false"
    }
  },
  "ignore_vines": false,
  "minimum_size": {
    "type": "minecraft:two_layers_feature_size"
  },
  "root_placer": {
    "type": "regions_unexplored:willow",
    "chance": 0.5,
    "height": {
      "type": "minecraft:uniform",
      "max_inclusive": 3,
      "min_inclusive": 2
    },
    "root_provider": {
      "id": "minecraft:oak_log",
      "properties": {
        "axis": "y"
      }
    }
  },
  "trunk_placer": {
    "type": "minecraft:straight_trunk_placer",
    "base_height": 7,
    "height_rand_a": 2,
    "height_rand_b": 1
  },
  "trunk_provider": {
    "id": "minecraft:oak_log",
    "properties": {
      "axis": "y"
    }
  }
}