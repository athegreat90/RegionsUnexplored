      "leaves_provider": {
        "id": "regions_unexplored:pine_leaves",
        "properties": {
          "distance": "7",
          "persistent": "false",
          "waterlogged": "false"
        }
      },
      "log_block": "regions_unexplored:pine_log",
      "probability": 0.1,
      "required_empty_blocks": 3
    },
    {
      "type": "minecraft:beehive",
      "probability": 0.001
    }
  ],
  "foliage_placer": {
    "type": "regions_unexplored:fancy_pine",
