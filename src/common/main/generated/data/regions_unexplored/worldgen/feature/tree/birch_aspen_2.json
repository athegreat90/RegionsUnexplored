{
  "type": "minecraft:tree",
  "below_trunk_provider": {
    "type": "minecraft:rule_based",
    "fallback": {
      "id": "minecraft:dirt"
    },
    "rules": [
      {
        "if_true": {
          "type": "minecraft:matching_block_tag",
          "tag": "regions_unexplored:peat/substrate"
        },
        "then": {
          "type": "regions_unexplored:key_hack",
          "block": "regions_unexplored:peat_dirt"
        }
      },
      {
        "if_true": {
          "type": "minecraft:matching_block_tag",
          "tag": "regions_unexplored:silt/substrate"
        },
        "then": {
          "type": "regions_unexplored:key_hack",
          "block": "regions_unexplored:silt_dirt"
        }
      }
    ]
  },
  "decorators": [
    {
      "type": "minecraft:beehive",
      "probability": 0.5
    },
    {
      "type": "regions_unexplored:random_branch",
      "branch_block": "regions_unexplored:birch_branch",
      "log_block": "minecraft:birch_log",
      "probability": 0.1,
      "required_empty_blocks": 4
    }
  ],
  "foliage_placer": {
    "type": "regions_unexplored:aspen"
  },
  "foliage_provider": {
    "id": "minecraft:birch_leaves",
    "properties": {
      "distance": "7",
      "persistent": "false",
      "waterlogged": "false"
    }
  },
  "ignore_vines": false,
  "minimum_size": {
    "type": "minecraft:two_layers_feature_size"
  },
  "trunk_placer": {
    "type": "regions_unexplored:aspen",
    "bend_chance": 0.5,
    "height": {
      "type": "minecraft:biased_to_bottom",
      "max_inclusive": 11,
      "min_inclusive": 6
    }
  },
  "trunk_provider": {
    "id": "minecraft:birch_log",
    "properties": {
      "axis": "y"
    }
  }
}